---
const tabs = [
  { id: "overview", label: "PROFILE & STACK", key: "1", icon: "👤" },
  { id: "ai", label: "AI & ML WORK", key: "2", icon: "⚡", badge: "ČEZ / ROBOSALES" },
  { id: "web", label: "WEB SHOWCASE", key: "3", icon: "🌐", badge: "3 SITES" },
  { id: "career", label: "CAREER.LOG", key: "4", icon: "📜" },
  { id: "cli", label: "CLI TERMINAL", key: "5", icon: "❯_" }
];
---

<nav class="tui-tabs" aria-label="Main Navigation">
  {tabs.map((tab, idx) => (
    <button 
      class={`tui-tab ${idx === 0 ? 'active' : ''}`} 
      data-tab={tab.id}
      aria-selected={idx === 0 ? "true" : "false"}
      role="tab"
    >
      <span class="key-shortcut">[{tab.key}]</span>
      <span>{tab.label}</span>
      {tab.badge && (
        <span style="font-size: 0.65rem; color: var(--tui-cyan); background: rgba(0, 245, 212, 0.1); padding: 0.05rem 0.3rem; border-radius: 2px;">
          {tab.badge}
        </span>
      )}
    </button>
  ))}
</nav>

<style>
  .tui-tab {
    cursor: pointer;
  }
</style>
