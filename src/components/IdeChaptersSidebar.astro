---
const chapters = [
  { id: "overview", file: "01_profile.py", label: "Profile & Tech Stack", key: "1", icon: "🐍", badge: "CORE" },
  { id: "ai", file: "02_ai_models.py", label: "ČEZ a.s. & Robosales", key: "2", icon: "⚡", badge: "AI / ML" },
  { id: "web", file: "03_websites.tsx", label: "Client Web Showcase", key: "3", icon: "🌐", badge: "3 SITES" },
  { id: "career", file: "04_career.log", label: "Git Career Timeline", key: "4", icon: "📜", badge: "LOG" }
];
---

<aside class="ide-chapters-panel" aria-label="IDE Chapters Navigation">
  <div class="ide-sidebar-header">
    <span>CHAPTERS & EXPLORER</span>
    <span style="color: var(--tui-cyan);">4 FILES</span>
  </div>

  <!-- Chapters List -->
  <div class="ide-chapters-list">
    {chapters.map((ch, idx) => (
      <div 
        class={`ide-chapter-item ${idx === 0 ? 'active' : ''}`}
        data-target={ch.id}
        role="button"
        tabindex="0"
      >
        <div class="ide-chapter-title-row">
          <span class="chapter-name">
            <span>{ch.icon}</span>
            <span>{ch.file}</span>
          </span>
          <span class="key-shortcut" style="font-size: 0.65rem; color: var(--tui-text-dim);">[{ch.key}]</span>
        </div>
        <div class="ide-chapter-desc">
          {ch.label}
        </div>
      </div>
    ))}
  </div>

  <!-- Outline / Symbols Subgroup -->
  <div class="ide-sidebar-subgroup">
    <div style="font-size: 0.7rem; font-weight: 700; color: var(--tui-text-dim); margin-bottom: 0.4rem; letter-spacing: 0.05em;">
      SYMBOLS & FUNCTIONS
    </div>
    <div class="ide-symbol-row">
      <span class="ide-symbol-name"><span style="color: var(--tui-purple);">ƒ</span> cez_enterprise_ai()</span>
      <span style="font-size: 0.65rem; color: var(--tui-green);">ACTIVE</span>
    </div>
    <div class="ide-symbol-row">
      <span class="ide-symbol-name"><span style="color: var(--tui-purple);">ƒ</span> robosales_assistant()</span>
      <span style="font-size: 0.65rem; color: var(--tui-yellow);">PROD</span>
    </div>
    <div class="ide-symbol-row">
      <span class="ide-symbol-name"><span style="color: var(--tui-purple);">ƒ</span> addai_rag_search()</span>
      <span style="font-size: 0.65rem; color: var(--tui-cyan);">RAG</span>
    </div>
    <div class="ide-symbol-row">
      <span class="ide-symbol-name"><span style="color: var(--tui-blue);">🌐</span> b2ts.cz</span>
      <span style="font-size: 0.65rem; color: var(--tui-text-dim);">Astro</span>
    </div>
    <div class="ide-symbol-row">
      <span class="ide-symbol-name"><span style="color: var(--tui-blue);">🌐</span> vpt-lipno.cz</span>
      <span style="font-size: 0.65rem; color: var(--tui-text-dim);">Astro</span>
    </div>
    <div class="ide-symbol-row">
      <span class="ide-symbol-name"><span style="color: var(--tui-blue);">🌐</span> doteku.cz</span>
      <span style="font-size: 0.65rem; color: var(--tui-text-dim);">Astro</span>
    </div>
  </div>

  <!-- System Environment & Live Telemetry -->
  <div class="ide-sidebar-subgroup" style="margin-top: auto; background: #0c0f1a;">
    <div style="font-size: 0.7rem; font-weight: 700; color: var(--tui-text-dim); margin-bottom: 0.4rem;">
      DEV WORKSPACE METRICS
    </div>
    <div style="font-size: 0.72rem; color: var(--tui-text-muted); display: flex; flex-direction: column; gap: 0.25rem;">
      <div style="display: flex; justify-content: space-between;">
        <span>BRANCH:</span>
        <span style="color: var(--tui-yellow); font-weight: 700;">ide-variant</span>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <span>PYTHON:</span>
        <span style="color: var(--tui-green);">3.14.8 [FastAPI]</span>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <span>ASTRO:</span>
        <span style="color: var(--tui-pink);">7.4.1 [Static]</span>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <span>AI RUNTIME:</span>
        <span style="color: var(--tui-cyan);">ČEZ Neural Mesh</span>
      </div>
    </div>
  </div>
</aside>

<script>
  // Link sidebar chapters to editor tabs
  const chapterItems = document.querySelectorAll('.ide-chapter-item');
  chapterItems.forEach((item) => {
    item.addEventListener('click', () => {
      const target = (item as HTMLElement).dataset.target;
      if (target && window.ideActivateChapter) {
        window.ideActivateChapter(target);
      }
    });
  });
</script>
