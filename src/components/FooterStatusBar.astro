---
import { PERSONAL_INFO } from '../data/portfolio';
---

<footer class="tui-statusbar">
  <div style="display: flex; align-items: center; flex-wrap: wrap;">
    <div class="statusbar-segment mode">NORMAL</div>
    <div class="statusbar-segment file">personal-web/portfolio.py</div>
    <div class="statusbar-segment git" style="font-size: 0.72rem;"> main [clean]</div>
    <div class="statusbar-segment status" style="font-size: 0.72rem;">● ČEZ a.s. AI Active</div>
  </div>

  <div style="display: flex; align-items: center; flex-wrap: wrap;">
    <div class="statusbar-segment" style="color: var(--tui-text-dim); font-size: 0.72rem;">
      HOTKEYS: <span style="color: var(--tui-cyan);">[1-5]</span> Tabs · <span style="color: var(--tui-pink);">[T]</span> CRT · <span style="color: var(--tui-yellow);">[S]</span> SFX
    </div>
    <div class="statusbar-segment" style="background: #171b29; color: var(--tui-text-muted); font-size: 0.72rem;">
      UTF-8
    </div>
    <div class="statusbar-segment" style="background: #1e2436; color: var(--tui-yellow); font-size: 0.72rem; font-weight: 700;">
      100%
    </div>
  </div>
</footer>
